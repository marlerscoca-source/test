{
  "name": "mise-en-place",
  "version": "1.0.0",
  "description": "Culinary School Text Editor",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build && electron-builder",
    "vite": "vite",
    "electron": "electron ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@mdxeditor/editor": "^3.20.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "yaml": "^2.4.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "vite": "^5.3.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.culinaryschool.misenenplace",
    "productName": "Mise en Place",
    "directories": { "output": "dist-app" },
    "files": ["dist/**/*", "electron/**/*", "data/**/*", "node_modules/**/*"]
  }
}
